# ---- API ----
# Leave empty in development — Vite proxies /api to localhost:5000.
# In production, set this to your deployed API, e.g.
#   VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=

# ---- Calendly ----
# MUST be a real event link, e.g. https://calendly.com/vlt-sutheesh/30min
# An empty or non-existent link shows a "calendar not connected" notice rather
VITE_CALENDLY_URL=

# embed    = Calendly loads inside /schedule (recommended — keeps the visitor
#            on your domain, so the Meta Pixel sees the whole funnel)
# redirect = the browser jumps to calendly.com; set that event's confirmation
#            page to redirect back to https://yourdomain.com/thank-you
VITE_CALENDLY_MODE=embed

# ---- Google Sheets, without a backend ----
# Set these ONLY if you are deploying the static site with no API running.
# The browser then posts leads straight to the Apps Script web app and the
# sheet becomes the lead store. If the Express API is deployed, leave these
# blank — it already mirrors leads into the same sheet, more reliably.
VITE_SHEET_WEBHOOK_URL=
VITE_SHEET_SECRET=

# NOTE: `npm run deploy:build` produces the DEMO build — the form fakes a
# response and nothing is stored. That one is for design review only.
# For the real site that captures leads, fill in the values above and run
# `npm run live:build`, which outputs to ../live.
