# ---- core ----
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vlt_landing
# Atlas example:
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/vlt_landing?retryWrites=true&w=majority

# Comma separated list of front-end origins allowed to call this API
CLIENT_URLS=http://localhost:5173,https://landing.vulturelines.com

# ---- lead export ----
ADMIN_API_KEY=change-this-to-a-long-random-string

# ---- Calendly ----
# The scheduling link for the discovery-call event type. MUST be a real event,
# e.g. https://calendly.com/vlt-sutheesh/30min — a link that does not exist
# makes Calendly serve its own marketing page. Setup: docs/calendly.md
CALENDLY_URL=
# From the Calendly webhook subscription. Optional but recommended: it is the
# only thing that records a cancellation.
CALENDLY_WEBHOOK_SECRET=

# ---- Google Sheets ----
# Every lead is mirrored into a sheet. Paste google-apps-script.gs into the
# sheet (Extensions -> Apps Script), deploy it as a web app, and put the
# /exec URL here. Full walkthrough in docs/google-sheet.md.
# Leave blank and the app skips it; leads still save to MongoDB.
GOOGLE_SHEET_WEBHOOK_URL=
# must match SHARED_SECRET at the top of google-apps-script.gs
GOOGLE_SHEET_SECRET=

# ---- WhatsApp lead alerts (Meta WhatsApp Cloud API) ----
# Leave blank and the app simply skips WhatsApp; leads still save and email
# still sends. Set up at https://developers.facebook.com -> WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# where new leads are sent, digits only, with country code
WHATSAPP_NOTIFY_TO=919791670504
# A business may only send free-form messages within 24h of the recipient's
# last message. Outside that, name an approved template here.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---- optional email alerts ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=leads@vulturelines.com
NOTIFY_TO=sales@vulturelines.com
